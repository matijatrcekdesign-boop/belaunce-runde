<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="details" label="COM_BELAUNCERUNDE_FIELDSET_DETAILS">
		<field name="id" type="hidden" />
		<field
			name="naziv"
			type="text"
			label="COM_BELAUNCERUNDE_FIELD_NAZIV_LABEL"
			description="COM_BELAUNCERUNDE_FIELD_NAZIV_DESC"
			required="true"
			maxlength="100"
			filter="string"
		/>
		<field
			name="alias"
			type="text"
			label="JFIELD_ALIAS_LABEL"
			description="COM_BELAUNCERUNDE_FIELD_ALIAS_DESC"
			maxlength="100"
			filter="cmd"
		/>
		<field
			name="opis"
			type="textarea"
			label="COM_BELAUNCERUNDE_FIELD_OPIS_LABEL"
			description="COM_BELAUNCERUNDE_FIELD_OPIS_DESC"
			rows="6"
			filter="safehtml"
		/>
		<field
			name="stanje"
			type="list"
			label="JSTATUS"
			default="1"
			filter="integer"
			>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>
	</fieldset>
</form>
