<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="Belaunce\Component\Belauncerunde\Administrator\Field">
	<fieldset name="details" label="COM_BELAUNCERUNDE_FIELDSET_DETAILS">
		<field name="id" type="hidden" />
		<field
			name="naslov"
			type="text"
			label="COM_BELAUNCERUNDE_FIELD_NASLOV_LABEL"
			description="COM_BELAUNCERUNDE_FIELD_NASLOV_DESC"
			required="true"
			maxlength="255"
			filter="string"
		/>
		<field
			name="alias"
			type="text"
			label="JFIELD_ALIAS_LABEL"
			description="COM_BELAUNCERUNDE_FIELD_ALIAS_DESC"
			maxlength="255"
			filter="cmd"
		/>
		<field
			name="tip_id"
			type="tip"
			label="COM_BELAUNCERUNDE_FIELD_TIP_LABEL"
			required="true"
			filter="integer"
		/>
		<field
			name="tezavnost_id"
			type="tezavnost"
			label="COM_BELAUNCERUNDE_FIELD_TEZAVNOST_LABEL"
			required="true"
			filter="integer"
		/>
		<field
			name="lokacija"
			type="text"
			label="COM_BELAUNCERUNDE_FIELD_LOKACIJA_LABEL"
			description="COM_BELAUNCERUNDE_FIELD_LOKACIJA_DESC"
			required="true"
			maxlength="255"
			filter="string"
		/>
		<field
			name="zacetek"
			type="calendar"
			label="COM_BELAUNCERUNDE_FIELD_ZACETEK_LABEL"
			description="COM_BELAUNCERUNDE_FIELD_ZACETEK_DESC"
			required="true"
			showtime="true"
			translateformat="true"
			format="%Y-%m-%d %H:%M:%S"
		/>
		<field
			name="dolzina_km"
			type="number"
			label="COM_BELAUNCERUNDE_FIELD_DOLZINA_LABEL"
			required="true"
			min="0.1"
			max="999.9"
			step="0.1"
			filter="float"
		/>
		<field
			name="trajanje_min"
			type="number"
			label="COM_BELAUNCERUNDE_FIELD_TRAJANJE_LABEL"
			description="COM_BELAUNCERUNDE_FIELD_TRAJANJE_DESC"
			min="1"
			max="1440"
			filter="integer"
		/>
		<field
			name="opombe"
			type="textarea"
			label="COM_BELAUNCERUNDE_FIELD_OPOMBE_LABEL"
			rows="6"
			filter="string"
		/>
		<field
			name="trasa_url"
			type="url"
			label="COM_BELAUNCERUNDE_FIELD_TRASA_URL_LABEL"
			description="COM_BELAUNCERUNDE_FIELD_TRASA_URL_DESC"
			maxlength="2048"
			validate="url"
			schemes="http,https"
			filter="url"
		/>
		<field
			name="odprto_za_goste"
			type="radio"
			label="COM_BELAUNCERUNDE_FIELD_ODPRTO_ZA_GOSTE_LABEL"
			layout="joomla.form.field.radio.switcher"
			default="0"
			filter="integer"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field
			name="stanje"
			type="list"
			label="JSTATUS"
			default="1"
			filter="integer"
			>
			<option value="1">COM_BELAUNCERUNDE_STANJE_OBJAVLJENA</option>
			<option value="2">COM_BELAUNCERUNDE_STANJE_ODPOVEDANA</option>
		</field>
		<field
			name="vodja_id"
			type="user"
			label="COM_BELAUNCERUNDE_FIELD_VODJA_LABEL"
			required="true"
			filter="integer"
		/>
	</fieldset>
</form>
