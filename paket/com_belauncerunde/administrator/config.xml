<?xml version="1.0" encoding="UTF-8"?>
<config>
	<fieldset name="component" label="COM_BELAUNCERUNDE_CONFIG_FIELDSET_COMPONENT">
		<field
			name="skupina_clani"
			type="usergrouplist"
			label="COM_BELAUNCERUNDE_CONFIG_SKUPINA_CLANI_LABEL"
			description="COM_BELAUNCERUNDE_CONFIG_SKUPINA_CLANI_DESC"
			default=""
		/>
		<field
			name="ohrani_podatke"
			type="radio"
			label="COM_BELAUNCERUNDE_CONFIG_OHRANI_PODATKE_LABEL"
			description="COM_BELAUNCERUNDE_CONFIG_OHRANI_PODATKE_DESC"
			layout="joomla.form.field.radio.switcher"
			default="1"
			filter="integer"
			>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field
			name="casovni_pas"
			type="timezone"
			label="COM_BELAUNCERUNDE_CONFIG_CASOVNI_PAS_LABEL"
			description="COM_BELAUNCERUNDE_CONFIG_CASOVNI_PAS_DESC"
			default="Europe/Ljubljana"
		/>
		<field
			name="privzeta_lokacija"
			type="text"
			label="COM_BELAUNCERUNDE_CONFIG_PRIVZETA_LOKACIJA_LABEL"
			description="COM_BELAUNCERUNDE_CONFIG_PRIVZETA_LOKACIJA_DESC"
			default="Gorenja vas"
			maxlength="255"
			filter="string"
		/>
		<field
			name="privzeto_trajanje_min"
			type="list"
			label="COM_BELAUNCERUNDE_CONFIG_PRIVZETO_TRAJANJE_LABEL"
			description="COM_BELAUNCERUNDE_CONFIG_PRIVZETO_TRAJANJE_DESC"
			default="180"
			filter="integer"
			>
			<option value="120">COM_BELAUNCERUNDE_TRAJANJE_2H</option>
			<option value="180">COM_BELAUNCERUNDE_TRAJANJE_3H</option>
			<option value="240">COM_BELAUNCERUNDE_TRAJANJE_4H</option>
			<option value="300">COM_BELAUNCERUNDE_TRAJANJE_5H</option>
		</field>
	</fieldset>
	<fieldset name="prijava" label="COM_BELAUNCERUNDE_CONFIG_FIELDSET_PRIJAVA">
		<field name="omejitev_runde_dan" type="list" filter="integer" default="5" label="COM_BELAUNCERUNDE_CONFIG_OMEJITEV_RUNDE_LABEL" description="COM_BELAUNCERUNDE_CONFIG_OMEJITEV_RUNDE_DESC">
			<option value="3">3</option>
			<option value="5">5</option>
			<option value="10">10</option>
		</field>
		<field name="omejitev_email_uro" type="list" filter="integer" default="3" label="COM_BELAUNCERUNDE_CONFIG_OMEJITEV_EMAIL_LABEL" description="COM_BELAUNCERUNDE_CONFIG_OMEJITEV_EMAIL_DESC">
			<option value="3">3</option>
			<option value="5">5</option>
			<option value="10">10</option>
		</field>
		<field name="omejitev_ip_uro" type="list" filter="integer" default="20" label="COM_BELAUNCERUNDE_CONFIG_OMEJITEV_IP_LABEL" description="COM_BELAUNCERUNDE_CONFIG_OMEJITEV_IP_DESC">
			<option value="10">10</option>
			<option value="20">20</option>
			<option value="50">50</option>
		</field>
		<field name="veljavnost_min" type="list" filter="integer" default="15" label="COM_BELAUNCERUNDE_CONFIG_VELJAVNOST_LABEL" description="COM_BELAUNCERUNDE_CONFIG_VELJAVNOST_DESC">
			<option value="10">10</option>
			<option value="15">15</option>
			<option value="30">30</option>
		</field>
		<field name="zapomni_si_me" type="radio" layout="joomla.form.field.radio.switcher" filter="integer" default="1" label="COM_BELAUNCERUNDE_CONFIG_ZAPOMNI_LABEL" description="COM_BELAUNCERUNDE_CONFIG_ZAPOMNI_DESC">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
	</fieldset>
	<fieldset
		name="acymailing"
		label="COM_BELAUNCERUNDE_CONFIG_FIELDSET_ACYMAILING"
		addfieldprefix="Belaunce\Component\Belauncerunde\Administrator\Field"
	>
		<field
			name="lista_clanov"
			type="acymlista"
			label="COM_BELAUNCERUNDE_CONFIG_LISTA_CLANOV_LABEL"
			description="COM_BELAUNCERUNDE_CONFIG_LISTA_CLANOV_DESC"
			default="0"
			filter="integer"
		/>
		<field
			name="lista_runde"
			type="acymlista"
			label="COM_BELAUNCERUNDE_CONFIG_LISTA_RUNDE_LABEL"
			description="COM_BELAUNCERUNDE_CONFIG_LISTA_RUNDE_DESC"
			default="0"
			filter="integer"
		/>
	</fieldset>
	<fieldset name="trasa" label="COM_BELAUNCERUNDE_CONFIG_TRASA">
		<field name="trasa_strava" type="radio" layout="joomla.form.field.radio.switcher" filter="integer" default="1" label="COM_BELAUNCERUNDE_CONFIG_TRASA_STRAVA">
			<option value="0">JNO</option><option value="1">JYES</option>
		</field>
		<field name="trasa_komoot" type="radio" layout="joomla.form.field.radio.switcher" filter="integer" default="1" label="COM_BELAUNCERUNDE_CONFIG_TRASA_KOMOOT">
			<option value="0">JNO</option><option value="1">JYES</option>
		</field>
		<field name="trasa_bikemap" type="radio" layout="joomla.form.field.radio.switcher" filter="integer" default="1" label="COM_BELAUNCERUNDE_CONFIG_TRASA_BIKEMAP">
			<option value="0">JNO</option><option value="1">JYES</option>
		</field>
	</fieldset>
	<fieldset name="gostje" label="COM_BELAUNCERUNDE_CONFIG_GOSTJE">
		<field name="gostje_omejitev" type="list" filter="integer" default="2" label="COM_BELAUNCERUNDE_CONFIG_GOSTJE_OMEJITEV" description="COM_BELAUNCERUNDE_CONFIG_GOSTJE_OMEJITEV_OPIS">
			<option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="5">5</option>
		</field>
		<field name="gostje_captcha" type="radio" layout="joomla.form.field.radio.switcher" filter="integer" default="0" label="COM_BELAUNCERUNDE_CONFIG_GOSTJE_CAPTCHA" description="COM_BELAUNCERUNDE_CONFIG_GOSTJE_CAPTCHA_OPIS">
			<option value="0">JNO</option><option value="1">JYES</option>
		</field>
		<field name="gostje_min_cas" type="number" filter="integer" default="3" min="0" label="COM_BELAUNCERUNDE_CONFIG_GOSTJE_CAS" description="COM_BELAUNCERUNDE_CONFIG_GOSTJE_CAS_OPIS" />
	</fieldset>
	<fieldset name="maili" label="COM_BELAUNCERUNDE_CONFIG_MAILI" addfieldprefix="Belaunce\Component\Belauncerunde\Administrator\Field">
		<field name="mail_sprozilna_polja" type="mailpolja" multiple="true" filter="string" checked="zacetek,lokacija"
			label="COM_BELAUNCERUNDE_CONFIG_MAIL_POLJA" description="COM_BELAUNCERUNDE_CONFIG_MAIL_POLJA_OPIS">
			<option value="zacetek">COM_BELAUNCERUNDE_FIELD_ZACETEK_LABEL</option>
			<option value="lokacija">COM_BELAUNCERUNDE_FIELD_LOKACIJA_LABEL</option>
		</field>
	</fieldset>
	<fieldset name="viber" label="COM_BELAUNCERUNDE_CONFIG_VIBER">
		<field name="viber_predloga" type="textarea" rows="8" filter="string" default=""
			label="COM_BELAUNCERUNDE_CONFIG_VIBER_PREDLOGA" description="COM_BELAUNCERUNDE_CONFIG_VIBER_PREDLOGA_OPIS" />
	</fieldset>
	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL">
		<field
			name="rules"
			type="rules"
			label="JCONFIG_PERMISSIONS_LABEL"
			filter="rules"
			validate="rules"
			component="com_belauncerunde"
			section="component"
		/>
	</fieldset>
</config>
